# Banco de dados
# Exemplo local: postgresql://postgres:postgres@localhost:5432/gymflow
# Exemplo Supabase: postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymflow

# JWT
SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-e-secreta
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Integração com IA (use apenas UM provedor)
# Provedor: "openai" ou "mock" (mock funciona sem chave, para demonstração)
AI_PROVIDER=mock
OPENAI_API_KEY=sk-sua-chave-aqui
OPENAI_MODEL=gpt-4o-mini

# CORS (URLs do frontend separadas por vírgula)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
